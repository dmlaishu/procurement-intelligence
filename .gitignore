# Personal presentation notes (kept local)
docs/

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Local MLflow runs and environment files
mlruns/
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# local tool settings (machine-specific paths)
.claude/

# procurement prototype data: keep the processed lab-diagnostics tables and the country list; the raw downloads,
# PDFs and the other scopes are rebuilt by `python -m procurement_demo.run_all`
procurement_demo/data/*
!procurement_demo/data/countries.json
!procurement_demo/data/health_lab/
procurement_demo/data/health_lab/*
!procurement_demo/data/health_lab/gold/
procurement_demo/output/*
!procurement_demo/output/health_lab/

# document RAG: PDFs, extracted text, embedding model and the vector index are rebuilt by
# `python -m procurement_rag.pipeline`; kept: the per-country manifests (what was fetched), the passages and their
# saved vectors (so a hosted copy of the app loads the index without re-embedding)
procurement_rag/data/*
!procurement_rag/data/*/
procurement_rag/data/*/*
!procurement_rag/data/*/manifest.json
!procurement_rag/data/*/chunks.parquet
!procurement_rag/data/*/embeddings.npz
procurement_rag/data/index/
procurement_rag/data/models/
